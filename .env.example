# Credenciais do Tailscale para autenticar o Gateway na Tailnet
# Obtenha em: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-kxxxxxxxxxxxxxxxxxxxxxxx

# Configurações do Cloudflare
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_API_TOKEN=seu_api_token_com_permissoes_worker_aqui
CLOUDFLARE_ZONE_ID=seu_zone_id_opcional

# Host do Gateway na Tailnet
TAILSCALE_GATEWAY_ORIGIN=https://gateway-homelab.tailnet.ts.net
